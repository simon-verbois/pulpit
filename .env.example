# ============================================================
# Pulpit frontend build-time configuration
# ============================================================
# WARNING: any VITE_* variable is compiled into the built JavaScript
# bundle and is PUBLIC to anyone who loads the page in a browser.
# NEVER put secrets, tokens, or credentials in a VITE_* variable.
#
# In the default same-origin deployment (nginx reverse-proxying both
# Pulpit and Pulp behind one origin) this can stay relative and you
# should not need to change it.
VITE_PULP_API_BASE_PATH=/pulp/api/v3

# Timezone the dev-build banner's timestamp is shown in (compose-dev.yml
# only - see src/app/layout/DevBanner.tsx), and that container log
# timestamps use at runtime. Any IANA zone name, e.g. Europe/Brussels.
# Defaults to UTC if left unset.
TZ=UTC

# ============================================================
# Local Pulp development environment (docker compose)
# ============================================================
# Pulp requires a SECRET_KEY for cryptographic signing of sessions,
# tokens, etc. Generate a real value with:
#   openssl rand -hex 32
# Do NOT commit a real value here or in compose.yml. compose.yml is
# written to fail fast if this is left empty.
PULP_SECRET_KEY=

# Host port Pulpit's nginx is published on (http://localhost:<port>/).
# This is the one public entry point in the full-stack (Mode B) workflow.
PULPIT_HTTP_PORT=8080

# Host port Pulpit's nginx serves HTTPS on (https://localhost:<port>/).
# Independent of PULPIT_HTTP_PORT above, which keeps working unchanged. Falls
# back to an automatically-generated self-signed certificate if nothing else
# is configured - see the Administration > TLS tab to install a manual or
# FreeIPA-issued certificate instead.
PULPIT_HTTPS_PORT=8443

# Tag of the published `simonverbois/pulpit` image (Docker Hub, the one
# image now - docs/adr/0007-merged-pulpit-container.md) compose.yml pulls -
# defaults to the latest release. Pin it (e.g. 2026.36.1) to deploy a
# specific version instead. Not used by compose-dev.yml, which always
# builds it from local source regardless of this value.
PULPIT_IMAGE_TAG=latest

# Tag of the published `simonverbois/pulp-pulpit` image (Docker Hub) -
# docker.io/pulp/pulp:stable plus the colocated signing-service reconciler
# (docs/adr/0008-colocated-signing-reconciler.md). Same "defaults to
# latest, pin to deploy a specific version" convention as PULPIT_IMAGE_TAG
# above. Not used by compose-dev.yml, which always builds it from local
# source regardless of this value.
PULP_PULPIT_IMAGE_TAG=latest

# The full public origin the browser actually uses to reach Pulpit - must
# match PULPIT_HTTP_PORT above (and the real hostname/scheme if you're not
# on localhost). Pulp's CSRF protection checks the browser's Origin header
# against this (see docs/DEPLOYMENT.md "CSRF_TRUSTED_ORIGINS"); get it wrong
# and logins will work but every subsequent action (including logout) 403s.
PULPIT_PUBLIC_ORIGIN=http://localhost:8080

# Host port Pulp itself is published on, published only for the fast
# frontend-iteration workflow (Mode A: Vite dev server proxies to this
# port directly - see docs/DEVELOPMENT.md). Not used, and not needed,
# when running the full stack through PULPIT_HTTP_PORT above.
PULP_HTTP_PORT=8180

# Optional. Encrypts secrets pulpit-core itself stores at rest (currently
# just Default Settings' proxy password - see pulpit-core/app/core/
# crypto.py). Leave empty and everything else keeps working; only setting a
# proxy password fails with a clear error until this is set. Must be a real
# Fernet key, NOT an arbitrary passphrase - generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do NOT commit a real value here or in compose.yml.
PULPIT_CORE_SECRET_KEY=

# Optional. Pulp's all-in-one image creates a single "admin" superuser on
# first boot with a random, unknown password (the username is always
# "admin" - pulpcore-manager's reset-admin-password has no --username flag,
# so there is no PULP_ADMIN_USERNAME to set).
#
# Leave this EMPTY to leave that account untouched. Set it to a real value
# to have Pulp's "admin" password reset to it on every `docker compose up`
# (see the pulp service's post_start hook in compose.yml) - useful for local
# dev so you have a known password to log into Pulpit with. LOCAL DEV ONLY -
# never reuse this value anywhere real.
#
# Also the credential pulpit's own API/worker loop use to call Pulp's own
# API on their own behalf (repository signing-field updates, signing-service
# lookups - docs/signing.md). Required for the signing module to be able to
# reach Pulp at all; leave unset and signing-related jobs simply fail with a
# clear "Pulp is currently unavailable"-style error until it's set.
PULP_ADMIN_PASSWORD=

# Optional. Seeds one sample Repository+Remote(+Distribution) per plugin on
# first boot so a fresh instance isn't empty. Defaults to false (opt-in) -
# set to "true" to enable; this makes outbound HTTPS calls to eight public
# fixture hosts using PULP_ADMIN_PASSWORD above. See docs/DEPLOYMENT.md
# "Fixture seed".
PULPIT_CORE_FIXTURE_SEED_ENABLED=false
