# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Test / coverage artifacts
coverage/
playwright-report/
test-results/
blob-report/
playwright/.auth/

# Env files (never commit real secrets)
.env
.env.*
!.env.example

# Kubernetes / Podman secret manifests, same idea as .env vs .env.example
# above
deployment/kube/00-secret.yaml
deployment/podman/00-secret.yaml

# Local Pulp/Pulpit data (bind-mount fallback only; named volumes are the default)
.data/

# Fetched OpenAPI schema (npm run api:fetch) - regenerated from a live Pulp
# instance. Deliberately gitignored, unlike its output src/api/generated/
# (which IS checked in) - see ADR 0004.
/src/api/schemas/

# Logs
*.log
npm-debug.log*

# Editor / OS junk
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# TypeScript build info
*.tsbuildinfo

# Python bytecode cache - anywhere in the repo, not just pulpit-core/ (the
# derived Pulp image's own reconciler scripts under deployment/docker/pulp/
# are plain Python run directly, same artifact).
__pycache__/

# pulpit-core (Python backend) - build/dev artifacts
pulpit-core/.venv/
pulpit-core/.pytest_cache/
pulpit-core/*.egg-info/

