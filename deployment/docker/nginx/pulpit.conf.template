# Same-origin reverse proxy for Pulpit + Pulp (ADR 0005). Since the merge
# (docs/adr/0007-merged-pulpit-container.md), nginx, pulpit-core, and
# pulpit-worker all run in this same container - only Pulp itself is a
# separate, externally-addressable service, reached via ${PULP_UPSTREAM}
# (a plain host:port, substituted by deployment/docker/pulpit/entrypoint.sh - never a
# fixed Compose-network hostname, so Pulp can be a sibling container, a
# Kubernetes Service, or a real remote host with no code change).
# pulpit-core itself is always plain http://127.0.0.1:8000 below - no
# variable needed, it can never be anywhere but this same container.
#
# Both server blocks below serve the exact same routes - see
# pulpit-locations.conf.template, shared via `include` so 8080 and 8443 can
# never drift out of sync route-wise.
#
# ${NGINX_LOCAL_RESOLVERS} is auto-detected from /etc/resolv.conf by the base
# nginx image's own /docker-entrypoint.d/15-local-resolvers.envsh (opted into
# via NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1, Dockerfile) - deliberately NOT
# hardcoded to Docker's embedded-DNS address (127.0.0.11): VERIFIED live that
# nothing listens there under Podman (its DNS runs on the network's own
# bridge gateway instead, no fixed address), and Kubernetes' CoreDNS
# ClusterIP isn't fixed either - reading /etc/resolv.conf is what makes this
# portable across all three.
server {
    listen 8080;
    server_name _;
    include /etc/nginx/pulpit-locations.conf;
}

# TLS - self-signed fallback generated automatically on first boot if
# nothing else is configured (Administration > TLS: manual upload replaces
# ${TLS_CERT_PATH}/${TLS_KEY_PATH} in place and
# request a reload - see docs/DEPLOYMENT.md "TLS"). 8080 keeps working
# unchanged; this is purely additive.
server {
    listen 8443 ssl;
    server_name _;
    ssl_certificate     ${TLS_CERT_PATH};
    ssl_certificate_key ${TLS_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    include /etc/nginx/pulpit-locations.conf;
}
